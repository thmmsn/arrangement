# Kopier til .env og fyll inn:  cp .env.example .env
# Leses av både `npm start` (lokalt) og `docker compose` (produksjon).
# Skriv verdiene uten anførselstegn. Alt unntatt DOMAIN og TUNNEL_TOKEN kan stå tomt.

# ============================================================================
# Domene og Cloudflare Tunnel (hovednettstedet)
# ============================================================================

# Domenet påmeldingssidene ligger på. Lenkene i e-postene blir https://DOMAIN/…
# La stå tomt ved lokal utvikling (da brukes http://localhost:3000).
# Uten en gyldig arrangementslenke svarer domenet bare «Not Found» – også på forsiden.
DOMAIN=booking.domain.com

# Språket på hovednettstedet: nb (norsk bokmål, standard) eller en (engelsk).
# Heter SITE_LANG fordi LANG allerede er en standard miljøvariabel i Linux.
SITE_LANG=nb

# Token for Cloudflare Tunnel (Zero Trust → Networks → Tunnels → Create → Docker).
# Brukes bare av docker compose.
TUNNEL_TOKEN=

# Overstyrer adressen i e-postlenkene, hvis den ikke skal være https://DOMAIN.
# BASE_URL=

# ============================================================================
# Administrasjon
# ============================================================================
# All administrasjon ligger under /admin (sider) og /api/admin (API):
#   /admin/ny              opprett arrangement
#   /admin/<hash>#<nøkkel> administrer ett arrangement (lenken sendes til arrangøren)

# Eget vertsnavn for administrasjon, f.eks. booking-admin.domain.com. Når det er satt, finnes
# /admin og /api/admin BARE der – på DOMAIN gir de 404. Legg én Cloudflare Access-regel på hele
# dette vertsnavnet. Tips: bruk ett nivå under domenet (booking-admin.domain.com, ikke
# admin.booking.domain.com), ellers dekkes det ikke av Cloudflares gratis sertifikat.
ADMIN_HOST=

# Cloudflare Access-verifisering. Påkrevd for å opprette arrangementer: appen sjekker selv at hver
# forespørsel til /admin og /api/admin har passert Access – også om Access-regelen skulle være
# feilkonfigurert. Uten disse er oppretting av arrangementer slått av.
#   CF_ACCESS_TEAM_DOMAIN: Zero Trust → Settings → Custom Pages → Team domain
#   CF_ACCESS_AUD:         Access → Applications → din app → Overview → Application Audience (AUD) Tag
#                          (flere kan skilles med komma)
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Bare for lokal utvikling uten Cloudflare Access: la alle som når /admin opprette arrangementer.
# Aldri i produksjon. Har ingen virkning når CF_ACCESS_* er satt.
# ADMIN_NO_AUTH=true

# ============================================================================
# E-post (Resend)
# ============================================================================

# API-nøkkel fra https://resend.com/api-keys. Uten nøkkel skrives e-postene til konsollen.
RESEND_API_KEY=
# Avsender. Domenet (her domain.com) må være verifisert i Resend.
EMAIL_FROM=Påmelding <booking@domain.com>

# ============================================================================
# Utseende
# ============================================================================
# Egne filer (logo, favicon, CSS) kan legges i mappen ./branding. De blir tilgjengelige som
# /assets/custom/<filnavn>, f.eks. LOGO_URL=/assets/custom/logo.svg (lokalt og i docker compose).
# Bilder og stilark kan også være https://-adresser.

# Navnet på nettstedet: vises øverst (hvis ingen logo), i fanetittelen, bunnteksten og e-postene.
SITE_NAME=
LOGO_URL=
# Høyden på logoen i piksler (16–200). Standard: 44.
LOGO_HEIGHT=
FAVICON_URL=

# Farger: #rrggbb, #rgb, fargenavn eller rgb()/hsl(). Tomt = standard (lune, varme jordfarger).
# Knapper og lenker (standard #8b2e2a)
COLOR_ACCENT=
# Tekst på knappene (standard #ffffff)
COLOR_ACCENT_TEXT=
# Sidebakgrunn (standard #f5efe4)
COLOR_BACKGROUND=
# Kort og skjema (standard #fffdf8)
COLOR_SURFACE=
# Brødtekst (standard #2b2420)
COLOR_TEXT=
# Hjelpetekst (standard #6b5e53)
COLOR_MUTED=
# Linjer og rammer (standard #e3d9c8)
COLOR_BORDER=
# «Påmelding åpen» og bekreftelser (standard #3e5a45)
COLOR_SUCCESS=
# Detaljer i båndet øverst (standard #b8893a)
COLOR_HIGHLIGHT=

# Fonter fra Google Fonts (navnet slik det står på fonts.google.com). Legg til vekter med
# «:wght@…» hvis fonten har dem, f.eks. FONT_HEADING=Playfair Display:wght@600
# Overskrifter (standard Cormorant Garamond)
FONT_HEADING=
# Brødtekst (standard Source Sans 3)
FONT_BODY=
# Sett til false for å ikke laste fonter fra Google (personvern). Da brukes fonten bare hvis den
# finnes på maskinen, ellers en standardfont.
GOOGLE_FONTS=true

# Hjørneradius på kort, knapper og felter i piksler (0 = skarpe hjørner). Standard: 6.
RADIUS=
# Det vevde båndet øverst på siden (true/false).
SHOW_BAND=true

# --- Tekster ---
# Bunntekst (standard: SITE_NAME)
FOOTER_TEXT=
# Lenke til personvernerklæring, vises i bunnteksten
PRIVACY_URL=

# Ekstra stilark for alt annet (lastes etter standardstilen), f.eks. /assets/custom/custom.css
CUSTOM_CSS_URL=

# ============================================================================
# Flere nettsteder (valgfritt)
# ============================================================================
# Samme app, database og admin kan betjene flere domener. Hvert ekstra nettsted får et prefiks,
# SITE_<ID>_, og finnes så snart SITE_<ID>_DOMAIN er satt. ID-en kan bare inneholde A–Z og 0–9.
#
# Et nettsted kan sette DOMAIN, BASE_URL, LANG og EMAIL_FROM, og alle temavariablene over
# (SITE_NAME, LOGO_URL, COLOR_ACCENT, FOOTER_TEXT …). Det som ikke er satt, arves fra
# hovednettstedet – bortsett fra FOOTER_TEXT, som bare arves når språket er det samme.
#
# Hvert arrangement hører til ett nettsted, som velges i skjemaet. Åpnes arrangementet på feil
# domene, sendes nettleseren videre til riktig. Husk å legge domenet til i Cloudflare-tunnelen.
#
# Eksempel: et engelsk nettsted på booking.domain.net ved siden av det norske over.
# SITE_NET_DOMAIN=booking.domain.net
# SITE_NET_LANG=en
# SITE_NET_SITE_NAME=Registration
# SITE_NET_LOGO_URL=/assets/custom/logo-en.svg
# SITE_NET_EMAIL_FROM=Registration <booking@domain.net>

# ============================================================================
# Øvrig
# ============================================================================

# Tidssonen arrangementstider vises og tolkes i.
TIME_ZONE=Europe/Oslo

# Disse settes automatisk i docker compose og trengs bare ved annen drift:
# PORT=3000
# DATABASE_PATH=data/booking.db        (i Docker alltid /data/booking.db, i volumet)
# CLIENT_IP_HEADER=cf-connecting-ip    (bare når appen KUN kan nås via Cloudflare)
# TRUST_PROXY=1                        (bak en vanlig reverse proxy som nginx/Caddy)
