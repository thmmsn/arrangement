# Kopier til .env og fyll inn. `npm start` leser .env automatisk.

# Offentlig adresse – brukes i lenkene i e-postene. Ingen skråstrek til slutt.
BASE_URL=https://booking.domain.com
PORT=3000

# Passord for å opprette nye arrangementer på /ny. Velg et langt og unikt passord.
ADMIN_PASSWORD=

# Resend (https://resend.com/api-keys). Uten nøkkel skrives e-postene til konsollen.
RESEND_API_KEY=
# Avsender. Domenet må være verifisert i Resend.
EMAIL_FROM="Påmelding <booking@domain.com>"

# Hvor SQLite-databasen lagres.
DATABASE_PATH=data/booking.db

# Tidssonen arrangementstider vises og tolkes i.
TIME_ZONE=Europe/Oslo

# Sett til 1 når appen står bak én reverse proxy (Caddy, nginx, Fly.io, Railway …),
# ellers ser rate limiting bare proxyens IP-adresse.
TRUST_PROXY=
